  "tutorial": [
    {
      "id": "t1",
      "text": "Welcome. Your job is to keep priority sites working through the attack \u2014 not to shoot down every dot. Let's build the chain step by step.",
      "freeform": true
    },
    {
      "id": "t2",
      "text": "First: SEE the threat. Place a Local sensor on a node near a starred site. Sensors give warning; they don't stop anything by themselves.",
      "requireAssetType": "local_sensor"
    },
    {
      "id": "t3",
      "text": "Now: DECIDE. Place a C2 node. This turns a track into a decision \u2014 without it, you can see a threat and still react too late.",
      "requireAssetType": "c2_node"
    },
    {
      "id": "t4",
      "text": "Now: ACT. Place a Counter-UAS unit near a starred site. It's cheap and efficient against drones \u2014 the threat in this scenario.",
      "requireAssetType": "counter_uas"
    },
    {
      "id": "t5",
      "text": "Finally: ABSORB. Place a Passive resilience package on a starred site. It reduces damage when something leaks through. Then press Run.",
      "requireAssetType": "passive_resilience"
    }
  ]
